{
  "name": "hiretrack-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "HireTrack - Single-college placement management system MVP",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test": "npm run test:server && npm run test:client",
    "seed:admin": "npm --prefix server run seed:admin",
    "seed:org": "npm --prefix server run seed:org",
    "seed:demo": "npm --prefix server run seed:demo",
    "seed:v3-demo": "npm --prefix server run seed:v3-demo",
    "privacy:retention": "npm --prefix server run privacy:retention",
    "perf:audit": "npm --prefix server run perf:audit",
    "backup": "npm --prefix server run backup",
    "restore": "npm --prefix server run restore",
    "migrate:v3-org-backfill": "npm --prefix server run migrate:v3-org-backfill --",
    "migrate:v3-resumes": "npm --prefix server run migrate:v3-resumes --",
    "verify:demo": "npm --prefix server run verify:demo"
  },
  "keywords": ["placement", "recruitment", "mern", "campus-hiring"],
  "author": "HireTrack Team",
  "license": "ISC"
}

