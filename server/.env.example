NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hiretrack
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_RESUME_SIZE_MB=5

# HireTrack v3 Default Organization & Feature Flags (optional; non-breaking defaults)
DEFAULT_ORG_NAME=HireTrack Campus Organization
DEFAULT_ORG_SLUG=default-org
DEFAULT_ORG_TIMEZONE=Asia/Kolkata
DEFAULT_ORG_STATUS=active
LEGACY_RECRUITER_FLOW=true
ALLOW_PUBLIC_STUDENT_SIGNUP=true

